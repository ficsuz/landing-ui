# Production environment (used by `vite build` in CI — default mode is production)
# The SPA calls a RELATIVE /api base, so requests are same-origin and the
# container's nginx proxies /api -> backend (see nginx.conf). Same-origin means
# no CORS and no mixed-content: works over http today and over https on fics.uz
# without changing the backend host. If the backend moves, edit nginx.conf only.
VITE_BASE_API=/api
VITE_MEDIA_URL=/api
VITE_OUT_DIR=dist
