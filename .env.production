# Production environment (used by `vite build` in CI — default mode is production)
# The SPA is served on :8005 and talks to the backend DIRECTLY on its own port.
# The browser reaches 80.241.214.247:5001 fine, so no nginx /api proxy is needed.
# NOTE: the backend must allow CORS from http://80.241.214.247:8005 (the SPA origin).
VITE_BASE_API=http://80.241.214.247:5001/api
VITE_MEDIA_URL=http://80.241.214.247:5001/api
VITE_OUT_DIR=dist
