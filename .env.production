# Production environment (used by `vite build` in CI — default mode is production)
# The SPA is served behind the host nginx, which routes:
#   /api    -> backend
#   /files/ -> MinIO
# So all backend calls use a RELATIVE /api base: the browser hits the same origin
# that served the SPA (e.g. http://80.241.214.247:8005/api/v1/...), never a hard-coded host:port.
VITE_BASE_API=/api
VITE_MEDIA_URL=/api
VITE_OUT_DIR=dist
